---
import Section from '~/components/layout/section.astro'
import OutboundLink from '~/components/ui/outbound-link.astro'
import { ContentCollections } from '~/services/content-collections'
import { siteRuntime } from '~/services/server-runtime'

interface Props {
  title: string
}

const { title } = Astro.props

const { entries: projects } = await siteRuntime.runPromise(
  ContentCollections.use((collections) => collections.getProjects()),
)
---

<Section title={title}>
  <ul class="space-y-2 *:before:mr-2 *:before:text-neutral-400 *:before:content-['-'] dark:*:before:text-neutral-500">
    {projects.map((project) => (
      <li>
        <div class="inline-block align-top">
          <OutboundLink href={project.data.link}>
            {project.data.title}
          </OutboundLink>
          <p class="text-neutral-500 dark:text-neutral-400 text-sm">
            {project.data.description}
          </p>
        </div>
      </li>
    ))}
  </ul>
</Section>
