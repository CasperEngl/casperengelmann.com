---
import { NodeRedis } from '@effect/platform-node'
import { Clock, Config, Duration, Effect, Layer, Schema } from 'effect'
import { FetchHttpClient } from 'effect/http'
import OutboundLink from '~/components/ui/outbound-link.astro'
import { GitHub, GitHubRepo } from '~/services/github'

class CachedStarredRepos extends Schema.Class<CachedStarredRepos>(
  'CachedStarredRepos',
)({
  expiresAt: Schema.String,
  repos: Schema.Array(GitHubRepo),
}) {}

const CachedStarredReposJson = Schema.fromJsonString(CachedStarredRepos)

const loadStarredRepos = Effect.fn('loadStarredRepos')(function* () {
  const redis = yield* NodeRedis.NodeRedis
  const github = yield* GitHub
  const cachedReposData = yield* redis.use((client) =>
    client.get('starred-repos'),
  )
  const cachedRepos = cachedReposData
    ? yield* Schema.decodeUnknownEffect(CachedStarredReposJson)(cachedReposData)
    : null

  if (cachedRepos) return cachedRepos.repos

  const repos = yield* github.getStarredRepos()
  const timeToLive = Duration.hours(1)
  const currentTime = yield* Clock.currentTimeMillis
  const expiryDate = new Date(currentTime + Duration.toMillis(timeToLive))
  const body = new CachedStarredRepos({
    expiresAt: new Intl.DateTimeFormat('en-GB', {
      dateStyle: 'short',
      timeStyle: 'medium',
      timeZone: 'Europe/Copenhagen',
    }).format(expiryDate),
    repos,
  })
  const encoded = yield* Schema.encodeEffect(CachedStarredReposJson)(body)

  yield* redis.use((client) =>
    client.set('starred-repos', encoded, {
      EX: Duration.toSeconds(timeToLive),
    }),
  )

  return repos
})

const starredRepos = await loadStarredRepos().pipe(
  Effect.provide(
    Layer.mergeAll(
      GitHub.layer,
      NodeRedis.layerConfig({ url: Config.String('REDIS_URL') }),
    ).pipe(Layer.provide(FetchHttpClient.layer)),
  ),
  Effect.runPromise,
)
---

<ul class="list-['-'] list-inside space-y-2 marker:text-neutral-400 dark:marker:text-neutral-500">
  {starredRepos?.map((repo) => (
    <li>
      <OutboundLink href={repo.html_url}>{repo.full_name}</OutboundLink>
    </li>
  ))}
</ul>
