{
  "name": "casperengelmann.com",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "bun --bun emdash init",
    "build": "bun --bun astro build",
    "dev": "bun --bun astro dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "bun --bun oxlint --deny-warnings",
    "lint:fix": "bun --bun oxlint --fix",
    "migrate:emdash": "bun scripts/migrate-astro-content-to-emdash.mjs",
    "predeploy": "bun --bun run build",
    "prepare": "effect-language-service patch",
    "preview": "bun --bun astro preview",
    "start": "bun ./dist/server/entry.mjs",
    "typecheck": "bun --bun astro check",
    "effect:diagnostics": "effect-language-service diagnostics --project tsconfig.json"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/node": "11.1.6",
    "@astrojs/react": "^7.0.0",
    "@base-ui/react": "^1.8.0",
    "@date-fns/tz": "^1.5.0",
    "@effect/platform-node": "^4.0.0-rc.118",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.0",
    "astro": "7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "effect": "^4.0.0-rc.118",
    "emdash": "^1.0.1",
    "image-size": "^2.0.4",
    "js-yaml": "^5.4.2",
    "kysely": "^0.29.6",
    "lucide-react": "^1.48.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "mime": "^4.1.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "redis": "^6.2.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@casperengl/oxlint-rules": "github:casperengl/lint-rules",
    "@cloudflare/kumo": "^2.14.0",
    "@effect/language-service": "^0.87.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "dotenv": "^18.0.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-plugin-eslint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.2",
  "volta": {
    "node": "26.9.0"
  },
  "emdash": {
    "seed": ".emdash/seed.json"
  }
}
